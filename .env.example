# Public URL of the deployed site (no trailing slash). Drives canonicals, sitemap, OG URLs.
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Where enquiry-form leads are POSTed as JSON (Zapier / Make / CRM / Slack webhook…).
# REQUIRED in production – the API returns an error if it is missing so leads are never lost silently.
LEADS_WEBHOOK_URL=""

# Optional: ISO date when the transformation challenge starts (banner hides after this).
NEXT_PUBLIC_CHALLENGE_STARTS_AT="2026-11-01T00:00:00-04:00"
